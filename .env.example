# Project Mangekyo — environment variable template
# Copy this file to .env and fill in real values. Do NOT commit .env.
#
# NVD_API_KEY — NIST NVD API key (free: https://nvd.nist.gov/developers/request-an-api-key)
#   With a key, NVD rate limit relaxes from 5 to 50 requests / 30s
#   (scorer sleep 6.5s -> 0.6s). Optional but strongly recommended.
NVD_API_KEY=your_key_here
